    {
      "parameters": {
        "jsCode": "return $input.all().map(item => ({\n  json: {\n    embeds: [{\n      title: item.json.title ? item.json.title.substring(0, 256) : \"Sans titre\",\n      url: item.json.link,\n      // On utilise le contenu nettoyé par le nœud précédent\n      description: item.json.content ? item.json.content.substring(0, 2048) : \"Pas de description\",\n      color: 16711680, // Rouge LEGO\n      // Ici on ajoute l'image si on l'a trouvée\n      image: item.json.imageUrl ? { url: item.json.imageUrl } : undefined,\n      fields: [\n        { \n          name: \"🕒 Publié le\", \n          value: item.json.pubDate || \"Date inconnue\", \n          inline: true \n        }\n      ],\n      footer: { text: \"Veille LEGO • N8N\" }\n    }]\n  }\n}));"
      },
