        "jsCode": "// 1. On récupère le texte brut de l'étape précédente\nconst raw = $input.first().json.content;\n\n// 2. On nettoie les balises markdown (```json ...)\nconst cleanText = raw.replace(/```json|```/g, \"\").trim();\n\n// 3. On transforme le texte en véritable objet JSON\nconst data = JSON.parse(cleanText);\n\n// 4. SÉCURITÉ LEGO : On filtre pour ne garder que ce qui contient \"LEGO\"\n// (C'est ici qu'on dégage GTA 6 et Mortal Kombat pour de bon !)\nconst onlyLego = data.news.filter(item => \n  item.title.toLowerCase().includes('lego') || \n  item.summary.toLowerCase().includes('lego')\n);\n\nreturn onlyLego;"
